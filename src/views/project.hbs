<html>
<head>
<link rel="stylesheet" href="../assets/css/style.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">LOGO</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
            <a class="nav-link" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#">My Project</button>
        </li>
      </ul>
    </div>
  </div>
</nav>
<h1><b>ADD MY PROJECT</b></h1>  
<form action="/project" method="POST" enctype="multipart/form-data">
  <div class="mb-3">
    <label for="projectname" class="form-label">Project Name</label>
    <input type="text" class="form-control" id="projectname" name="projectname" placeholder="Project Name" required>
  </div>
  <div class="mb-3">
    <label for="startdate" class="form-label">Start Date</label>
    <input type="date" class="form-control" id="startdate" name="startdate" required>
  </div>
  <div class="mb-3">
    <label for="enddate" class="form-label">End Date</label>
    <input type="date" class="form-control" id="enddate" name="enddate" required>
  </div>
  <div class="mb-3">
    <label for="description" class="form-label">Description</label>
    <textarea class="form-control" id="description" name="description" rows="3" required></textarea>
  </div>
</div>
  <div class="mb-3">
    <label class="form-label">Technologies Used:</label><br>
    <div class="form-check form-check-inline">
      <input class="form-check-input" type="checkbox" id="NodeJs" name="technologies" value="NodeJs">
      <label class="form-check-label" for="NodeJs">NodeJs</label>
    </div>
    <div class="form-check form-check-inline">
      <input class="form-check-input" type="checkbox" id="NextJs" name="technologies" value="NextJs">
      <label class="form-check-label" for="NextJs">NextJs</label>
    </div>
    <div class="form-check form-check-inline">
      <input class="form-check-input" type="checkbox" id="ReactJs" name="technologies" value="ReactJs">
      <label class="form-check-label" for="ReactJs">ReactJs</label>
    </div>
    <div class="form-check form-check-inline">
      <input class="form-check-input" type="checkbox" id="TypeScript" name="technologies" value="TypeScript">
      <label class="form-check-label" for="TypeScript">TypeScript</label>
    </div>
  </div>
  <div class="mb-3">
    <label for="image" class="form-label">Project Image</label>
    <input class="form-control" type="file" id="image" name="image" accept="image/*">
  </div>
  <button type="submit" class="button">Submit</button>
</form>
<h1><b>MY PROJECTS</b></h1>
<div class="container mt-4">
  <div class="row g-4">
    {{#each projects}}
      <div class="col-12 col-sm-6 col-md-4 d-flex align-items-stretch">
        <div class="card mb-4 w-100" style="overflow:hidden;">
          {{#if this.image}}
            <img src="/project-image/{{this.id}}" class="card-img-top" alt="Project Image" style="object-fit:cover;max-height:200px;">
          {{/if}}
          <div class="card-body d-flex flex-column">
            <h5 class="card-title">{{this.projectname}}</h5>
            <p class="card-text">{{this.description}}</p>
            <p class="card-text"><strong>Start:</strong> {{this.startdate}} <strong>End:</strong> {{this.enddate}}</p>
            {{#if this.technologies}}
              <p class="card-text"><strong>Technologies:</strong> {{this.technologies}}</p>
            {{/if}}
            <div class="mt-auto d-flex gap-2">
              <a href="/project-detail/{{this.id}}" class="button">Detail</a>
              <form action="/project-delete/{{this.id}}" method="POST" style="display:inline;">
                <button type="submit" class="button btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this project?');">Delete</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</div>
