<html>
<head>
<link rel="stylesheet" href="style.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body>
  <nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">LOGO</a>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <a class="nav-link" href="/project">Back</button>
      </div>
    </div>
  </nav>

  <div class="card">
    <div class="card-body">
      {{#if project}}
        <h3>{{project.projectname}}</h3>
        <p><strong>Start:</strong> {{project.startdate}} <strong>End:</strong> {{project.enddate}}</p>
        <p>{{project.description}}</p>
        {{#if project.image}}
          <img src="/project-image/{{project.id}}" alt="Project Image" style="max-width:400px;max-height:300px;border-radius:6px;object-fit:cover;" />
        {{/if}}
        {{#if project.technologies}}
          <p><strong>Technologies:</strong> {{project.technologies}}</p>
        {{/if}}
      {{else}}
        <p>Project not found.</p>
      {{/if}}
    </div>
  </div>
</body>
</html>
